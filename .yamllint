---
extends: default

# Skip paths that aren't our source — the local virtual-env holds thousands
# of third-party YAML files (Ansible's own) that we neither own nor commit.
ignore: |
  .venv/

rules:
  line-length:
    max: 160
    level: warning
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
